; DbDo.jkm -- JAWS key map for DbDo.exe
;
; Purpose: tell JAWS to pass certain key combinations directly to
; DbDo instead of running JAWS's default handlers for them. DbDo
; provides its own table-style cell navigation (Alt+Control+arrow
; family) inside a virtual-mode ListView; without this key map,
; JAWS intercepts those chords and either runs its own table-
; navigation script (which says "Not in a table") or runs an
; unrelated default action.
;
; This file is loaded together with the compiled DbDo.jsb whenever
; DbDo.exe gains foreground focus, layering on top of the default
; key map. The bindings here invoke a Script named PassDbDoKey,
; defined in DbDo.jsb, whose body is one line: a call to the JAWS
; built-in Function TypeCurrentScriptKey(), which passes the current
; keystroke through to the application as if no script were running.
; The Function cannot be invoked from a JKM directly (the JKM format
; requires a Script name on the right-hand side), which is why the
; wrapping Script exists.
;
; The [Common Keys] section applies to every keyboard layout
; (desktop and laptop). The ; -----------------------------------------------------------------
; The grid's row keys (2 November 2026). Each script passes the key
; quietly in the grid and runs JAWS's own script anywhere else.
; -----------------------------------------------------------------
DownArrow=nextDbDoRow
UpArrow=priorDbDoRow
PageDown=nextDbDoPage
PageUp=priorDbDoPage
; -----------------------------------------------------------------
; The keyboard model of 31 October 2026: the cell above or below,
; first and last marked record, marking and unmarking to the first or
; last row, and the screen readers' table reading keys with Shift.
; -----------------------------------------------------------------
Alt+UpArrow=passDbDoKey
Alt+DownArrow=passDbDoKey
Control+PageUp=passDbDoKey
Control+PageDown=passDbDoKey
Control+Shift+Home=passDbDoKey
Control+Shift+End=passDbDoKey
Alt+Control+Shift+Home=passDbDoKey
Alt+Control+Shift+End=passDbDoKey
Alt+Control+Shift+LeftArrow=passDbDoKey
Alt+Control+Shift+RightArrow=passDbDoKey
Alt+Control+Shift+UpArrow=passDbDoKey
Alt+Control+Shift+DownArrow=passDbDoKey
Alt+Control+Shift+NumPad5=passDbDoKey
[Keyboard Layouts] section at the
; bottom tells JAWS the Common section is the layout source for
; both modes.
;
; To customize a specific binding, change the right-hand side of
; the relevant line to any other Script name JAWS can resolve.

[Common Keys]

; -----------------------------------------------------------------
; Virtual cell navigation (the primary reason this file exists).
; DbDo announces each cell with screen-reader-style direction-
; aware framing; JAWS's own table-reading chords don't recognize
; the virtual-mode ListView as a table, so we hand the chords
; directly to DbDo.
; -----------------------------------------------------------------
Alt+Control+Home=passDbDoKey
Alt+Control+End=passDbDoKey
Alt+Control+RightArrow=passDbDoKey
Alt+Control+LeftArrow=passDbDoKey
Alt+Control+DownArrow=passDbDoKey
Alt+Control+UpArrow=passDbDoKey
Alt+Control+PageDown=passDbDoKey
Alt+Control+PageUp=passDbDoKey
Alt+Control+NumPad5=passDbDoKey

; -----------------------------------------------------------------
; Alt-letter command chords. DbDo binds many Alt+Letter chords as
; one-keystroke command aliases (Alt+R = Recent Files, Alt+P = Say
; Path, Alt+Z = Say Status, Alt+Y = Say Yield, Alt+T = Table
; Statistics, Alt+C = Frequency Chart, Alt+L = Choose Visible
; Columns, Alt+A = Sort Ascending, Alt+D = Sort by Date, Alt+E =
; Extract Regex, Alt+K = Go to Bookmark). JAWS by default lets the
; Alt chord open the menu bar; we pass it through so DbDo's menu-
; level Alt mnemonic does NOT fire and the form-level handler runs.
; -----------------------------------------------------------------
Alt+A=passDbDoKey
Alt+C=passDbDoKey
Alt+D=passDbDoKey
Alt+E=passDbDoKey
Alt+K=passDbDoKey
Alt+L=passDbDoKey
Alt+P=passDbDoKey
Alt+R=passDbDoKey
Alt+T=passDbDoKey
Alt+Y=passDbDoKey
Alt+Z=passDbDoKey
Alt+Shift+A=passDbDoKey
Alt+Shift+D=passDbDoKey
Alt+Shift+R=passDbDoKey

; -----------------------------------------------------------------
; Parent-child drill family. Alt+RightArrow / Alt+LeftArrow /
; Alt+Home each have a meaningful DbDo binding (Enter Child
; Table / Exit Child Table / Exit to Root Table) that JAWS would
; otherwise intercept for navigation announcements.
; -----------------------------------------------------------------
Alt+RightArrow=passDbDoKey
Alt+LeftArrow=passDbDoKey
Alt+Home=passDbDoKey
Alt+End=passDbDoKey

; -----------------------------------------------------------------
; Plain editing keys repurposed as data-grid commands. In the grid
; DbDo binds Backspace = Exit Child, Enter = Enter Child, Delete =
; Remove Record, and F12 = Edit Config. With no script bound for
; the app, JAWS falls back to announcing these keys by NAME (the
; reported "it says Backspace"). Passing them through suppresses
; that announcement. Behavior elsewhere is unchanged: in an edit
; field Backspace and Delete still speak the character they remove,
; because that echo comes from the control's text change, not from
; the JAWS default key handler this binding replaces.
; -----------------------------------------------------------------
Backspace=passDbDoKey
Enter=passDbDoKey
Delete=passDbDoKey
F12=passDbDoKey

; -----------------------------------------------------------------
; Search-family chords. Control+F / Control+J / Control+F3 open
; the three search dialogs; F3 / Shift+F3 repeat the last search.
; JAWS has a default Control+F binding in some contexts that we
; want DbDo to take instead.
; -----------------------------------------------------------------
Control+F=passDbDoKey
Control+J=passDbDoKey
Control+Shift+F=passDbDoKey
Control+Shift+J=passDbDoKey
Control+F3=passDbDoKey
Control+Shift+F3=passDbDoKey
F3=passDbDoKey
Shift+F3=passDbDoKey

; -----------------------------------------------------------------
; Marked-row navigation. Control+Home / Control+End / Control+Up /
; Control+Down jump among marked rows in DbDo; JAWS would otherwise
; treat Control+Home/End as document-start/document-end speech and
; Control+Up/Down as say-prior-paragraph / say-next-paragraph.
; -----------------------------------------------------------------
Control+Home=passDbDoKey
Control+End=passDbDoKey
Control+UpArrow=passDbDoKey
Control+DownArrow=passDbDoKey

; -----------------------------------------------------------------
; Bulk-mark span chords. Shift+Home / Shift+End mark every row
; from the first or current through the current or last; Alt+Shift
; variants unmark.
; -----------------------------------------------------------------
Shift+Home=passDbDoKey
Shift+End=passDbDoKey
Alt+Shift+Home=passDbDoKey
Alt+Shift+End=passDbDoKey

; -----------------------------------------------------------------
; Say-X family on Shift+letter (data-list only in DbDo). Shift+A
; and Shift+C are clipboard cell ops; Shift+D speaks the updated
; date in human-friendly local form; Shift+L sweeps the virtual
; column; Shift+N speaks the notes field; Shift+T speaks the tags
; field; Shift+Y speaks the marked-row count; Shift+F4 lists the
; visited tables. Alt+Shift+M speaks the marked-row look values
; (the former Shift+L command moved here).
; -----------------------------------------------------------------
Shift+A=passDbDoKey
Shift+C=passDbDoKey
Shift+D=passDbDoKey
Shift+K=passDbDoKey
Shift+L=passDbDoKey
Shift+N=passDbDoKey
Shift+T=passDbDoKey
Shift+Y=passDbDoKey
Shift+F4=passDbDoKey
Alt+Shift+M=passDbDoKey

; -----------------------------------------------------------------
; Range-mark family on F8 / Shift+F8 / Alt+F8 / Alt+Shift+F8.
; F8 sets mark anchor; Shift+F8 marks to anchor; Alt+F8 sets unmark
; anchor; Alt+Shift+F8 unmarks to anchor. JAWS does not intercept
; these chords in data lists, but we pass them explicitly so
; DbDo's handler always wins.
; -----------------------------------------------------------------
F8=passDbDoKey
Shift+F8=passDbDoKey
Alt+F8=passDbDoKey
Alt+Shift+F8=passDbDoKey

; -----------------------------------------------------------------
; Alt+Delete: DbDo's Say Position command. JAWS uses Alt+Delete
; for "Say JAWS Cursor Position" by default; this pass-through
; lets DbDo's column-and-row announcement win in the data list.
; -----------------------------------------------------------------
Alt+Delete=passDbDoKey

; -----------------------------------------------------------------
; Shift+8 (asterisk) and Numpad asterisk: DbDo's Say Sort and
; Filter command. JAWS does not normally intercept these but we
; pass them through explicitly so the dispatch is unambiguous.
; -----------------------------------------------------------------
Shift+8=passDbDoKey
NumPadStar=passDbDoKey

; -----------------------------------------------------------------
; Alt+Apostrophe: DbDo's Say Clipboard command. JAWS does have an
; Alt+Apostrophe binding ("Say JAWS Version") that we want OUR
; handler to win over inside DbDo's data list. Pass it through.
; -----------------------------------------------------------------
Alt+Apostrophe=passDbDoKey

[Keyboard Layouts]
Desktop=Common
Laptop=Common
