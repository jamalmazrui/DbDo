; DbDo.inix - sample configuration
;
; Two copies of this file are used:
;
;   1. The shipped template, next to DbDo.exe, which provides defaults
;      and documents what every section is for. Edit-Configuration's
;      "Open file..." button DOES NOT touch this copy.
;
;   2. The per-user file at %LOCALAPPDATA%\DbDo\DbDo.inix, which
;      overrides the shipped template on a per-key basis. DbDo writes
;      to this copy when remembering the last opened database, the
;      last-used dialog folders, and any saved configuration changes.
;
; The .inix extension is DbDo's extended ini format (Inix). Every
; classic ini construct works: ';' or '#' comments, [Section]
; headers, name = value lines with whitespace trimmed and
; case-insensitive key names. Inix adds MULTI-LINE VALUES:
;
;   Fenced form (reliable for any content, including '=' signs):
;     key=`
;     first line of the value
;     second line of the value
;     `
;   A triple-quote fence (three double-quote characters) works the
;   same way. All fenced text is verbatim -- no escape characters.
;
;   Plain form (for simple text without '=' at line starts):
;     key=
;     first line
;     second line
;
; Inix also lets a key hold an ARRAY of values. When there are only a
; few items and none contains a space or comma, they may be written
; inline, separated by commas:
;
;     SelectFields = last_name, first_name, enterprise
;
; Otherwise -- more items, or items that contain spaces or commas --
; each item goes on its own line under the "key =" line, using the
; fenced form (default the ` fence; a triple-quote fence is used
; automatically when an item itself contains a ` ). The most recent
; item comes first:
;
;     FindText = `
;     smith
;     jones, robert
;     annual report 2026
;     `
;
; Either form reads back as the same ordered list, so you can edit a
; setting in whichever shape is more convenient.
;
; The ConnectStrings section below uses the fenced form, because
; connection strings are long and contain '=' characters.

[General]
; HistoryCount sets how many entries each history keeps -- the
; custom-query history (Alt+Shift+Q), the search/find/jump
; histories, and the recent-files list. Default 10; range 1 to 100.
HistoryCount = 10

; UiMode controls which surface(s) DbDo presents at startup.
;
;   gui  = GUI window only (the default). The dot-prompt console is
;          opt-in: summon it on demand with Control+GraveAccent or
;          Tools > Enter-Console.
;   both = GUI window AND a separate console window with the dot
;          prompt at startup. Two distinct accessibility surfaces;
;          Alt+Tab between them.
;   cli  = Console only, no GUI. When launched from cmd.exe, attaches
;          to the launching terminal.
;
; Command-line flags -cli, -gui, -both override this setting.
UiMode = gui

[Console]
; FollowActiveWindow: Y (default) = the Dot Prompt's table/recordset
; context follows the most recently active window; N = the prompt
; stays pinned to the window that opened it until Enter-Console is
; invoked again from another window.
FollowActiveWindow=Y

[Validation]
; Type-default "picture" patterns (dBASE III+ PICTURE spirit).
; Key = declared type; value = .NET regex a non-empty value must
; match in the record edit dialog. Per-table-and-field patterns
; elsewhere in this file override these; the entries below match
; the compiled defaults and may be edited or removed freely.
; Empty values always pass (nullable fields).
BOOLEAN=^(0|1)$
INTEGER=^[+-]?[0-9]+$
REAL=^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$
NUMERIC=^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)$
TEXTTIME=^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?)?$

[Hotkeys]

; Each line: Command Name=Chord, Imperative description.
;
; The CHORD field is documentation only -- it shows the binding so
; you and other readers know what to press. Bindings themselves are
; compiled into the program and cannot be changed by editing this
; file. Modifiers are always Alt, Control, Shift (in that order).
; Key names use JAWS conventions (Apostrophe, Backslash, UpArrow,
; NumPadPlus, Grave, etc.) so they match what your screen
; reader announces.
;
; The DESCRIPTION field IS loaded at startup. Edit the wording, save
; the file, restart DbDo, and the new description appears in the
; status bar (when a menu item is focused) and in key-describer mode
; (Control+F1, press any chord to hear its name and description).
; Keep descriptions to one sentence in imperative voice, weaving
; common synonyms where useful, and -- where natural -- reinforcing
; the mnemonic between the chord letter and the command name.

; ===== File menu =====
Open Database=Control+O, Open a database file on disk
New Database=None, Create a new database file
Add Table=None, Add another table in the standard shape to the open database
Recent Files=Alt+R, Pick a recently opened database to reopen
Close Database=None, Close the open database
Export Data=Alt+Shift+X, Export the records in view, with the shown columns, to a file
Exit Application=Alt+F4, Exit (quit) DbDo

; ===== Edit menu =====
New Record=Control+N, Add a new record at the cursor
Copy Record as New=Control+Shift+N, Start a new record from the current record's values
Edit View=Control+E, Edit the current record field by field
Edit Cell=F2, Edit the current cell value in place
Delete Record=Control+D, Delete (remove) the current record after confirming; when records are marked, first choose Current (default) or Marked. The Delete key also works
Delete Record Force=Control+Shift+D, Delete the current record without confirmation
Copy Cell=Control+C, Copy the current cell value to the clipboard
Append Cell=Alt+C, Append the current cell value to the clipboard
Copy Record=Control+Shift+C, Copy the whole current record to the clipboard
Append Record=Alt+Shift+C, Append the whole current record to the clipboard
Open Cell=Control+Enter, Open the current cell's value as a path or url
Open url=Control+Shift+U, Open the current record's url in the default browser
Pick Value=Control+F2, Pick a value from the current field's values
Replace=Control+R, Replace text in the fields and records you choose
Replace with Regex=Control+Shift+R, Replace, with Use regex pattern checked
Send Mail=None, Send mail using the current record (mailto link); on the Edit menu (no hotkey)

; ===== Mark menu =====
Set Mark=Control+M, Mark the current record for batch operations
Marked Toggle=Control+Space, Toggle (flip) the mark on the current record
Edit Notes=Alt+Shift+N, Edit the record's notes
Edit Tags=Alt+Shift+T, Edit the record's tags
Edit url=Alt+Shift+U, Edit the record's url
Clear Mark=Control+Shift+M, Unmark (clear the mark on) the current record
Cursor Row Start=Home, Move to the record's first column
Cursor Row End=End, Move to the record's last column
Cursor Column First=Control+Home, Move to the column's first record
Cursor Column Last=Control+End, Move to the column's last record
Cursor Grid Start=Alt+Control+Home, Move to the first column of the first record
Cursor Grid End=Alt+Control+End, Move to the last column of the last record
Cell Down=Alt+Control+DownArrow, Move one cell down
Cell Left=Alt+Control+LeftArrow, Move one cell left
Cell Right=Alt+Control+RightArrow, Move one cell right
Cell Up=Alt+Control+UpArrow, Move one cell up
Column Top=Alt+Control+PageUp, Move to the column's first record
Column Bottom=Alt+Control+PageDown, Move to the column's last record
Say Row Header=Alt+Control+Shift+LeftArrow, Say the record's look without moving
Say Column Header=Alt+Control+Shift+UpArrow, Say the column's name without moving
Say Row=Alt+Control+Shift+RightArrow, Say every shown field of the record without moving
Say Column=Alt+Control+Shift+DownArrow, Say every value in the column from the first record
Say Cell Coordinates=Alt+Control+Shift+NumPad5, Say the cell's record and column numbers
Mark to First=Control+Shift+Home, Mark every record from the first to the current one
Mark to Last=Control+Shift+End, Mark every record from the current one to the last
Unmark to First=Alt+Control+Shift+Home, Unmark every record from the first to the current one
Unmark to Last=Alt+Control+Shift+End, Unmark every record from the current one to the last
Mark and Next=Shift+DownArrow, Mark the current record and move to the next
Mark and Previous=Shift+UpArrow, Mark the current record and move to the previous
Unmark and Next=Alt+Shift+DownArrow, Unmark the current record and move to the next
Unmark and Previous=Alt+Shift+UpArrow, Unmark the current record and move to the previous
Next Marked=Control+DownArrow, Go to the next marked record
Previous Marked=Control+UpArrow, Go to the previous marked record
Context Menu=Shift+F10, Open the context menu
Repeat Set Position=Alt+G, Repeat the Go To command with the previously saved input (saved across sessions in DbDo.inix)
Null Value=Control+Shift+Backspace, Set the current field to null
First Marked=Control+PageUp, Go to the first marked record
Last Marked=Control+PageDown, Go to the last marked record
Set Mark All=Control+A, Mark every visible record in the filtered view
Clear Mark All=Control+Shift+A, Unmark (clear marks on) every visible record
Invert Marked=Alt+Shift+I, Invert the marked state of every visible record
Start Mark=F8, Start marking from the current record (set anchor)
Complete Mark=Shift+F8, Complete marking from the anchor to the current record
Start Unmark=Alt+F8, Start unmarking from the current record (set anchor)
Unmark Range=Alt+Shift+F8, Complete unmarking from the anchor to the current record
Save Bookmark=Control+B, Bookmark (save) the current record so you can return later
List Bookmarks=Alt+B, List saved bookmarks and pick one to jump to that record
Clear Bookmark=Control+Shift+B, Clear (remove) a saved bookmark or all of them

; ===== Navigate menu =====
Inspect Record=Control+I, Show the record field by field, with its related records
View Cycle=F6, Cycle to the next view of the current record: list to edit to inspect and back to list (Control+E and Control+I jump straight to the edit and inspect views)
View Cycle Back=Shift+F6, Cycle to the previous presentation of the current record (list, show, form)
Set Position=Control+G, Go to a record by its number, a percent or text
Switch Object=Control+F6, Switch to the next open table window
Switch Previous Object=Control+Shift+F6, Switch to the previous open table window
Switch Table=None, Switch to the next visited table
Switch Previous Table=None, Switch to the previously visited table
Select Table=Control+T, Select a table to open in this window
Open Table=Control+Shift+O, Open a table in a new window
Current Windows=F4, Pick window to activate from list of current ones
Window Toggle=None, Toggle between the two most recently used windows (Control+Tab and Control+Shift+Tab move between windows)
Next Window=Control+Tab, Activate next open window
Previous Window=Control+Shift+Tab, Activate previous open window
Say Windows Open=Shift+F4, Say count and titles of open windows
Close Window=Control+F4, Close current window
Close All But Current Window=Control+Shift+F4, Close all windows except the current one
Enter Child=Alt+RightArrow, Go into the records related to this one
Exit Child=Alt+LeftArrow, Exit (back out of) the child relation to the parent record (Backspace also steps out)
Exit Child to Root=Alt+Home, Go back to the first table
Table Properties=Alt+Enter, Show the table's properties
Keywords=Control+K, Go to the next record whose fields hold the keywords
Keywords Previous=Control+Shift+K, Go to the previous record whose fields hold the keywords
Find Regex=Control+F3, Find the next record matching a regular expression
Find Previous Regex=Control+Shift+F3, Find the previous record matching a regular expression
Jump Record=Control+J, Go to the next record whose current field holds the text
Jump Previous Record=Control+Shift+J, Go to the previous record whose current field holds the text
Search Next=F3, Repeat the last Keywords, Jump or Find Regex, forward
Search Previous=Shift+F3, Repeat the last Keywords, Jump or Find Regex, backward

; ===== Order and Filter =====
Order Records=Alt+O, Order the records by the fields you choose
Reverse Order=Alt+Shift+O, Reverse the order of the records
Add Column to Order=Alt+A, Order the records by the current field first, ascending
Add Column to Order Descending=Alt+Shift+A, Order the records by the current field first, descending
Filter Records=Control+F, Show only the records that match what you choose
Clear Filter=Control+Shift+F, Show every record again, staying on the same record

; ===== Query/Say menu =====
Say Added=Shift+A, Say when the record was added
Say Bookmark=Shift+B, Say the bookmarked record
Say Cell=Shift+C, Say the column and value of the cell
Say Database=Shift+D, Say the database's name and folder
Say Edited=Shift+E, Say when the record was last edited
Say Filter=Shift+F, Say the filter in force
Say Go to=Shift+G, Say the last Go to entry
Say ID=Shift+I, Say the record's id
Say Jump=Shift+J, Say the last Jump entry
Say Keywords=Shift+K, Say the last Keywords entry
Say Look=Shift+L, Say the record's look
Say Marked=Shift+M, Say whether the record is marked
Say Notes=Shift+N, Say the record's notes
Say Order=Shift+O, Say the order in force
Say Prime=Shift+P, Say the record's prime fields
Say Query=Shift+Q, Say the query behind the records
Say Related=None, Say the records related to this one; part of Say Whole Record
Say Select Columns=Shift+S, Say the columns the grid shows
Say Tags=Shift+T, Say the record's tags
Say url=Shift+U, Say the record's url
Say Replace Values=Shift+R, Say the last Replace and Replace with Regex values
Say Whole Record=Shift+W, Say every field of the record, then its related records
Say Yield=Alt+Y, Say how many records are in view
Say Status=Shift+Z, Say the table, record, order and filter
Say Invoke Script=Shift+V, Say the script Invoke Script would choose
Say Yield Marked=Shift+Y, Say how many records are marked
Say Tables=None, Say the tables visited this session
Say Clipboard=Alt+Apostrophe, Say the current clipboard text
Say Position=Alt+Delete, Say current position, record count, and percent through
Say Order Filter=Shift+8, Say the active order and filter, or none for each
Say Column as List from Current=Control+L, Say the column's values from the current record down
Say Column as List from Current Marked=Control+Shift+L, Say the column's values for marked records from the current record down
Say Records from Current=None, Say every record in full from the cursor down (no length cap)
Say Records from Current Marked=Alt+Shift+M, Say every marked record in full from the cursor down (no length cap)

; ===== Misc menu =====
Database Summary=Alt+D, Show a summary of the database: tables, record counts and relations
Table Summary=Alt+T, Show a summary of the table: fields, types and keys
Generate from Grid=Alt+Shift+G, Make a report from the records in the grid
Select Columns=Alt+S, Choose the columns the grid shows and their order
Update View=F5, Refresh the records' values from the database
Extract with Regex=Control+Shift+E, Copy every regular expression match from the fields and records you choose
Query=Control+Q, Run an SQL statement
Query History=Alt+Shift+Q, Pick a previously-run custom query (Control+Q) from the saved history and run it again; the list is newest first, up to 20
Invoke Script=Alt+V, Run a script from the list of scripts
Edit Snippet=Alt+Shift+S, Edit a script file in the configured text editor
Edit Settings=Alt+Shift+E, Edit DbDo settings stored in the configuration file
Open in Explorer=Alt+Backslash, Open the folder of the open database in Windows Explorer
Out Printer=None, Print the current grid; hidden until it is built
Enter Console=Control+Grave, Enter (summon) the DbDo console window

; ===== Toggles =====
Read Only Toggle=Control+Shift+Z, Toggle read-only mode to protect data from edits Views and query results that cannot be updated are read-only by nature and the toggle cannot unlock them.
Extra Speech Toggle=Alt+Shift+Z, Toggle extra speech messages on or off
Key Describer Toggle=Control+F1, Toggle key describer mode: pressing a key says its command instead of running it

; ===== Help menu =====
Get Help=F1, Get (display) DbDo documentation
What This Does=Shift+F1, What this does: say in one sentence what the control with focus does
Hotkey Summary=None, List every command with its key and description
Open Command Prompt=Control+Backslash, Open a Windows command prompt in the folder of the open database
Show History=Control+Shift+F1, Open the history of DbDo's changes, newest first
About DbDo=Alt+F1, About: display DbDo version number and release date
Alternate Menu=Alt+F10, Pick any command from one list, in menu, name or key order
Show Status=Control+Slash, Say where you are, what has focus and the keys; twice, show them in a window
Play Stream=Control+P, Play the current record's stream
Elevate Version=F11, Elevate (download and install) the latest DbDo version

[Folders]

; DbDo writes to this section automatically to remember the folder
; the user last visited in each kind of file dialog. The next time
; the same kind of dialog opens, it starts in the remembered folder
; instead of forcing the user to navigate back from the default.
;
; Three keys are maintained:
;
;   open    - shared by File > New, Open, Save-As, Backup. All four
;             operate on whole-database files, and users typically keep
;             their databases together, so one shared "open" folder is
;             more useful than four separate ones.
;
;   import  - File > Import-Data source files (Markdown tables).
;
;   export  - File > Export-Data target files.
;
; If a remembered folder no longer exists on disk, DbDo falls back to
; (in order) the folder of the currently-open database, then the user's
; Documents folder, then lets Windows pick.
;
; You can edit these values to seed a starting folder, but DbDo will
; overwrite them after the next dialog use.
;
; open   = C:\Users\you\Databases
; import = C:\Users\you\Inbox
; export = C:\Users\you\Reports

[Session]

; DbDo writes to this section automatically to remember which database
; and table were last open, so the next launch returns to the same place.
; You can clear these by deleting the file, or override them with the
; -open <path> command-line flag.
;
; LastDatabase = C:\Users\you\Documents\budget.db
; LastTable    = transactions

[Options]

; CommandEcho controls whether DbDo announces each command's name
; through the screen reader (GUI) or prints a [Command-Name] marker
; (CLI) just before the command runs. Default Y. Set to N if you
; find the confirmation
; noisy.
CommandEcho = N

[ConnectStrings]

; Maps a file-extension token to the ADODB connection string used
; when DbDo opens a file with that extension. The literal substring
; "{path}" in a template is replaced with the full file path at
; connection time; "{folder}" is replaced with the directory
; containing the file (used by drivers that open a folder of files
; rather than a single file, such as the Jet text driver and dBASE).
;
; The defaults below match the connection strings DbDo's C# code
; uses internally; the ini values OVERRIDE the built-in defaults so
; an advanced user can switch drivers (for example, replace the
; SQLite ODBC driver name to point at a newer build, or change
; Excel's IMEX flag for stricter type detection).
;
; To restore a default, comment the line out or delete it.

; SQLite databases (.db, .sqlite, .sqlite3). The ch-werner SQLite
; ODBC driver is a pass-through to the SQLite library version
; bundled with the driver -- full modern SQL surface available.
db=`
Driver={SQLite3 ODBC Driver};Database={path};
`
sqlite=`
Driver={SQLite3 ODBC Driver};Database={path};
`
sqlite3=`
Driver={SQLite3 ODBC Driver};Database={path};
`

; Microsoft Access (.mdb = Jet 4.0, .accdb = ACE). Access SQL
; dialect (IIF instead of CASE, * and ? for LIKE wildcards, etc.).
mdb=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={path};Persist Security Info=False;
`
accdb=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={path};Persist Security Info=False;
`

; Excel (.xls = Excel 8.0 / Jet 4.0, .xlsx and .xlsm = Excel 12.0
; Xml / ACE). HDR=Yes treats the first row as column headers;
; change to HDR=No to refer to columns as F1, F2, F3 etc. IMEX=1
; coerces all columns to text on read, which mitigates the
; first-8-rows type-detection gotcha for sparse numeric columns.
xls=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={path};Extended Properties="Excel 8.0;HDR=Yes;IMEX=1";
`
xlsx=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={path};Extended Properties="Excel 12.0 Xml;HDR=Yes;IMEX=1";
`
xlsm=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={path};Extended Properties="Excel 12.0 Macro;HDR=Yes;IMEX=1";
`

; dBASE (.dbf). The connection is to the folder containing the
; .dbf; each .dbf in the folder becomes a table. Field identifiers
; are 10 characters max, no spaces or hyphens.
dbf=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={folder};Extended Properties="dBASE IV;HDR=No;IMEX=1";
`

; Plain-text delimited files (.csv, .tsv). The Jet text driver
; connects to the folder; each file in the folder becomes a table.
; CSV uses Delimited format; TSV uses TabDelimited. SELECT works
; well; INSERT is limited; UPDATE / DELETE are effectively absent.
csv=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={folder};Extended Properties="text;HDR=Yes;FMT=Delimited";
`
tsv=`
Provider=Microsoft.ACE.OLEDB.12.0;Data Source={folder};Extended Properties="text;HDR=Yes;FMT=TabDelimited";
`

; =====================================================================
; PER-DATABASE SETTINGS  (documented here; stored elsewhere)
; =====================================================================
;
; The settings above live in this file, DbDo.inix. A second, separate
; file holds settings that belong to ONE database and travel with it:
; <DbName>.inix, kept beside the database file (for example
; Budget.inix next to Budget.db). It uses the same Inix format and the
; same UpperCamelCase, two-word key convention. DbDo writes it
; automatically; you may also edit it by hand to pin a database's
; starting view. It has two kinds of section.
;
; [Database] -- settings for the database as a whole:
;
;   InitialTable   The table opened in the first window when the
;                  database is opened, so there is always a starting
;                  window. Additional tables open in their own windows
;                  via Open Table (Control+Shift+O). A single table
;                  name; if you pin one here it wins over the
;                  last-used table.
;
;   The recent-input lists, each an ARRAY of up to ten items, most
;   recent first, offered in the matching command's combo box:
;
;   FindText       recent Find Record text
;   JumpText       recent Jump to Record text
;   ReplaceText    recent Replace text
;   ReplaceRegex   recent regex patterns, from before Replace was one dialog
;   QueryText      recent SQL statements run via Query
;
; [Table:<name>] -- the saved view for one table, recalled when that
; table is next opened:
;
;   SelectFields   the columns to display, in order (an array)
;   OrderFields    the sort order (an array)
;   WhereFilter    the filter condition (a single expression)
;
; Example <DbName>.inix:
;
;   [Database]
;   InitialTable = books
;   FindText = `
;   hemingway
;   annual report 2026
;   `
;   QueryText = `
;   select title, author from books where year > 2000 order by author
;   `
;
;   [Table:books]
;   SelectFields = title, author, year, rating
;   OrderFields = author, title
;   WhereFilter = rating >= 4
