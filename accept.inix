; accept.inix -- what "done" means for DbDo, written down so a script settles it.
;
; checkHomerApp runs every check here and records the command, the exit code and
; the verdict in its evidence report. A criterion that cannot be written this way
; belongs in help\self.md under what a person has to check by hand.

FileTask = accept


[check]

; A CHECK IS ONE CONDITION, AND THE TEST LIVES IN A FILE. A line here is run
; through a shell that already wraps it in cmd /c, so parentheses and an else
; written here are parsed twice and answer 1 whatever is true. scripts\acceptCheck
; does the looking, and takes two words: exists or missing, and a path.
Name = the patterns hold
Run = scripts\auditPatterns.cmd

[check]

Name = the local AI scripts ship in scripts
Run = scripts\acceptCheck.cmd exists scripts\installOllama.cmd

[check]

Name = the model script ships in scripts
Run = scripts\acceptCheck.cmd exists scripts\installModels.cmd

[check]

Name = the starter databases are in templates
Run = scripts\acceptCheck.cmd exists templates\JobTrail\JobTrail.db

[check]

Name = the book template is in templates
Run = scripts\acceptCheck.cmd exists templates\BookTrail\BookTrail.db

[check]

Name = no samples folder remains
Run = scripts\acceptCheck.cmd missing Samples

[check]

Name = the build runs clean against the kit
Run = buildDbDo.cmd nobump

[check]

Name = the program was produced
Run = scripts\acceptCheck.cmd exists exec\DbDo.exe

[check]

Name = the snippet module was produced
Run = scripts\acceptCheck.cmd exists exec\DbDo.dll

[check]

Name = the local copies of the Homer classes are gone
Run = scripts\acceptCheck.cmd missing Lbc.cs

[check]

Name = the walks pass the tutorial checker
Run = scripts\checkTutorial.cmd

[check]

Name = a session log lands where the Homer layout says
Run = scripts\acceptCheck.cmd exists "%LOCALAPPDATA%\DbDo\logs"
