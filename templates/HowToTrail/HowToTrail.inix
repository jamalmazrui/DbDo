; HowToTrail.inix -- how this database opens, and how each table is heard.
;
; ONE DATABASE FOR EVERY SYSTEM. The Windows and iOS tutorial databases had the
; same shape -- tasks, methods, apps, contacts -- and answering "how do I do this
; on my phone?" meant opening a different file. They are one database now, and
; the system is a field: platform, on tasks, methods and apps, holding Windows,
; iOS, or any for something that is true on both. F4 in the field picks from
; that list. To work in one system only, put platform = "Windows" in the Where
; filter, Control+W, and it stays until you clear it.
;
; The accessibility articles that were the old how-to database are here too, in
; articles and categories. They are about the web rather than about a system, so
; they carry no platform.

[Database]

InitialTable = tasks

[Table:tasks]

; What you are trying to do, and where. The name comes first, because that is
; what you look up; the system and the area narrow it.
SelectFields = name, platform, area
OrderFields = platform, area, name
WhereFilter =

[Table:methods]

SelectFields = name, platform, summary
OrderFields = platform, name
WhereFilter =

[Table:apps]

SelectFields = name, platform, category
OrderFields = platform, name
WhereFilter =

[Table:articles]

SelectFields = name, issue, version
OrderFields = name
WhereFilter =

[Table:categories]

SelectFields = name, summary
OrderFields = name
WhereFilter =

[Table:contacts]

SelectFields = last_name, first_name, enterprise
OrderFields = last_name, first_name
WhereFilter =

[Table:lookups]

SelectFields = fld, val
OrderFields = fld, ordinal
WhereFilter =

[Table:maps]

SelectFields = kind, prime1, prime2
OrderFields = kind, prime1
WhereFilter =
