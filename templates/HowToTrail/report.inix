; Report definitions for HowToTrail, which gathers Windows procedures (for
; JAWS, NVDA and Narrator) and iOS procedures (for VoiceOver, from "Personal
; Power: Getting the Most From iOS as a Totally Blind User" by Michael Feir).
; Run with Run Report (Alt+Shift+R). A report reads the whole table, not the
; grid: filtering the grid first does not narrow it. To narrow a report, give
; it an @filter line, as the examples below show; to output just the rows you
; can see, use Generate from Grid (Alt+Shift+G) instead.

; The app catalog, grouped by category -- the iOS apps the guide teaches.
; FileTask marks this file's purpose so DbDo shows it only for the
; matching command (here, Run Report / Alt+Shift+R).
FileTask = report

[app_catalog]
@table = apps
@group = category
group_header = """
## $category
"""
detail = """
- **$name** -- $descrip
"""
group_footer = """
*$count app(s) in this category.*
"""
footer = """
**$count apps in total.**
"""

; Topics the guide explains, grouped by area (its thematic sections). For one
; area or one platform, add a line such as  @filter = platform = 'iOS'
[tasks_by_area]
@table = tasks
@group = area
group_header = """
## $area
"""
detail = """
- $name
"""
group_footer = """
*$count topic(s).*
"""
footer = """
**$count topics documented in the guide.**
"""

; A flat list of step-by-step methods, each headed by its name and platform.
; This reads every method -- several hundred -- so narrow it with @filter: for
; one platform,  @filter = platform = 'Windows' ; for a name search,
;  @filter = name LIKE '%Excel%' . Windows methods are written for JAWS, NVDA
; or Narrator; iOS methods for VoiceOver.
[method_steps]
@table = methods
@sort = platform, name
detail = """
### $name ($platform)

$steps
"""
footer = """
**$count method(s) listed.**
"""
