INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1614, '2026-11-03 21:20:34', '2026-11-03 21:20:34', '*', 'added', NULL, NULL, 'fieldDescriptions', 'When this record was added; DbDo fills it in.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1615, '2026-11-03 21:20:34', '2026-11-03 21:20:34', '*', 'edited', NULL, NULL, 'fieldDescriptions', 'When this record was last changed; DbDo updates it on every save.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1616, '2026-11-03 21:20:34', '2026-11-04 01:44:44', '*', 'look', NULL, NULL, 'fieldDescriptions', 'How the record is said in a list, built by DbDo from the table''s look fields, which are also the default columns.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1617, '2026-11-03 21:20:34', '2026-11-03 21:20:34', '*', 'marked', NULL, NULL, 'fieldDescriptions', 'Whether you have marked this record, 1 for marked and 0 for not; Control+Space toggles it.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1618, '2026-11-03 21:20:34', '2026-11-03 21:20:34', '*', 'notes', NULL, NULL, 'fieldDescriptions', 'Your own notes in sentences, as long as you like; Markdown is welcome.', NULL, NULL, NULL, 0, NULL);
