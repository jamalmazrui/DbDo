CREATE INDEX "idx_maps_map_id" ON "maps" ("map_id");
CREATE INDEX "idx_maps_added" ON "maps" ("added");
CREATE INDEX "idx_maps_edited" ON "maps" ("edited");
CREATE INDEX "idx_maps_tags" ON "maps" ("tags");
CREATE INDEX "idx_maps_marked" ON "maps" ("marked");
CREATE INDEX "idx_lookups_lookup_id" ON "lookups" ("lookup_id");
CREATE INDEX "idx_lookups_added" ON "lookups" ("added");
CREATE INDEX "idx_lookups_edited" ON "lookups" ("edited");
CREATE INDEX "idx_lookups_url" ON "lookups" ("url");
CREATE INDEX "idx_lookups_tags" ON "lookups" ("tags");
CREATE INDEX "idx_lookups_marked" ON "lookups" ("marked");
CREATE UNIQUE INDEX "idx_lookups_prime" on "lookups" (prime);
CREATE UNIQUE INDEX "idx_maps_prime" on "maps" (prime);
CREATE UNIQUE INDEX stations_prime ON stations(prime);
CREATE INDEX stations_geo ON stations(country, state);
CREATE INDEX stations_genre ON stations(genre);
CREATE INDEX stations_votes ON stations(votes);
CREATE INDEX "idx_stations_station_id" ON "stations" ("station_id");
CREATE INDEX "idx_stations_added" ON "stations" ("added");
CREATE INDEX "idx_stations_edited" ON "stations" ("edited");
CREATE INDEX "idx_stations_source_id" ON "stations" ("source_id");
CREATE INDEX "idx_stations_tags" ON "stations" ("tags");
CREATE INDEX "idx_stations_marked" ON "stations" ("marked");
CREATE TRIGGER "trg_lookups_edited" AFTER UPDATE OF "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags" ON "lookups" FOR EACH ROW WHEN OLD."tbl" IS NOT NEW."tbl" OR OLD."fld" IS NOT NEW."fld" OR OLD."val" IS NOT NEW."val" OR OLD."ordinal" IS NOT NEW."ordinal" OR OLD."src" IS NOT NEW."src" OR OLD."descrip" IS NOT NEW."descrip" OR OLD."url" IS NOT NEW."url" OR OLD."notes" IS NOT NEW."notes" OR OLD."tags" IS NOT NEW."tags" BEGIN UPDATE "lookups" SET edited = CURRENT_TIMESTAMP WHERE "lookup_id" = NEW."lookup_id"; END;
CREATE TRIGGER "trg_lookups_maps" AFTER UPDATE ON "lookups" FOR EACH ROW WHEN OLD.prime IS NOT NEW.prime BEGIN UPDATE maps SET prime1 = NEW.prime WHERE tbl1 = 'lookups' AND prime1 = OLD.prime; UPDATE maps SET prime2 = NEW.prime WHERE tbl2 = 'lookups' AND prime2 = OLD.prime; END;
CREATE TRIGGER "trg_lookups_maps_delete" AFTER DELETE ON "lookups" FOR EACH ROW BEGIN DELETE FROM maps WHERE (tbl1 = 'lookups' AND prime1 = OLD.prime) OR (tbl2 = 'lookups' AND prime2 = OLD.prime); END;
CREATE TRIGGER "trg_maps_edited" AFTER UPDATE OF "kind", "tbl1", "prime1", "tbl2", "prime2", "notes", "tags" ON "maps" FOR EACH ROW WHEN OLD."kind" IS NOT NEW."kind" OR OLD."tbl1" IS NOT NEW."tbl1" OR OLD."prime1" IS NOT NEW."prime1" OR OLD."tbl2" IS NOT NEW."tbl2" OR OLD."prime2" IS NOT NEW."prime2" OR OLD."notes" IS NOT NEW."notes" OR OLD."tags" IS NOT NEW."tags" BEGIN UPDATE "maps" SET edited = CURRENT_TIMESTAMP WHERE "map_id" = NEW."map_id"; END;
CREATE TRIGGER "trg_stations_edited" AFTER UPDATE OF "name", "slogan", "genre", "country", "state", "language", "stream_url", "playlist_url", "homepage", "codec", "bitrate", "hls", "countrycode", "source", "source_id", "status", "rating", "descrip", "notes", "tags", "call_sign", "frequency", "city", "owner", "format", "wikipedia" ON "stations" FOR EACH ROW WHEN OLD."name" IS NOT NEW."name" OR OLD."slogan" IS NOT NEW."slogan" OR OLD."genre" IS NOT NEW."genre" OR OLD."country" IS NOT NEW."country" OR OLD."state" IS NOT NEW."state" OR OLD."language" IS NOT NEW."language" OR OLD."stream_url" IS NOT NEW."stream_url" OR OLD."playlist_url" IS NOT NEW."playlist_url" OR OLD."homepage" IS NOT NEW."homepage" OR OLD."codec" IS NOT NEW."codec" OR OLD."bitrate" IS NOT NEW."bitrate" OR OLD."hls" IS NOT NEW."hls" OR OLD."countrycode" IS NOT NEW."countrycode" OR OLD."source" IS NOT NEW."source" OR OLD."source_id" IS NOT NEW."source_id" OR OLD."status" IS NOT NEW."status" OR OLD."rating" IS NOT NEW."rating" OR OLD."descrip" IS NOT NEW."descrip" OR OLD."notes" IS NOT NEW."notes" OR OLD."tags" IS NOT NEW."tags" OR OLD."call_sign" IS NOT NEW."call_sign" OR OLD."frequency" IS NOT NEW."frequency" OR OLD."city" IS NOT NEW."city" OR OLD."owner" IS NOT NEW."owner" OR OLD."format" IS NOT NEW."format" OR OLD."wikipedia" IS NOT NEW."wikipedia" BEGIN UPDATE "stations" SET edited = CURRENT_TIMESTAMP WHERE "station_id" = NEW."station_id"; END;
CREATE TRIGGER "trg_stations_maps" AFTER UPDATE ON "stations" FOR EACH ROW WHEN OLD.prime IS NOT NEW.prime BEGIN UPDATE maps SET prime1 = NEW.prime WHERE tbl1 = 'stations' AND prime1 = OLD.prime; UPDATE maps SET prime2 = NEW.prime WHERE tbl2 = 'stations' AND prime2 = OLD.prime; END;
CREATE TRIGGER "trg_stations_maps_delete" AFTER DELETE ON "stations" FOR EACH ROW BEGIN DELETE FROM maps WHERE (tbl1 = 'stations' AND prime1 = OLD.prime) OR (tbl2 = 'stations' AND prime2 = OLD.prime); END;
