INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1651, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'votes', NULL, NULL, 'How many people have voted for the station on Radio Browser.', '^$|^[0-9]+$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1652, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'clicks', NULL, NULL, 'How often people have played the station through Radio Browser.', '^$|^[0-9]+$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1653, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'trend', NULL, NULL, 'Whether plays are rising or falling lately on Radio Browser.', '^$|^-?[0-9]+$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1654, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'countrycode', NULL, NULL, 'The country''s two-letter code in capitals, such as US or GB.', '^$|^[A-Z]{2}$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1655, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'source', NULL, NULL, 'Which directory the station came from, such as Radio Browser or SomaFM, or mine for your own; it cannot be left blank.', '^\s*\S.*$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1656, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'source_id', NULL, NULL, 'The station''s id in that directory, which keeps it the same station across refreshes.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1657, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'last_check', NULL, NULL, 'When the directory last found the stream working, as year-month-day.', '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1658, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'last_seen', NULL, NULL, 'When DbDo last found the station in the directory.', '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1659, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'probed', NULL, NULL, 'When DbDo last asked the stream and home page about themselves.', '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1660, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'status', NULL, NULL, 'Your own verdict on the station, such as favorite, tried, untried, want to try or dead; F4 offers the choices.', '^$|^(favorite|tried|untried|want to try|dead)$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1661, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'rating', NULL, NULL, 'Your own rating of the station, from 1 to 5.', '^$|^[1-5]$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1662, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'descrip', NULL, NULL, 'What the station says about itself, from its stream or home page.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1663, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'call_sign', NULL, NULL, 'The broadcast call sign, such as KUOW, for an over-the-air station.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1664, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'frequency', NULL, NULL, 'Where the station is on the dial, such as 94.9 FM.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1665, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'city', NULL, NULL, 'The city the station is licensed to.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1666, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'owner', NULL, NULL, 'Who owns the station.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1667, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'format', NULL, NULL, 'The station''s broadcast format, such as news, sports or classic rock.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1668, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'wikipedia', NULL, NULL, 'The web address of the station''s Wikipedia article, or a dash when there is none.', '^$|^-$|^https://[a-z-]+\.wikipedia\.org/\S+$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1669, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'plays', NULL, NULL, 'How many times you have played the station in DbDo.', '^$|^[0-9]+$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1670, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'last_played', NULL, NULL, 'When you last played the station in DbDo.', '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1671, '2026-11-03 23:38:19', '2026-11-04 21:20:50', 'defs', 'pattern', NULL, NULL, 'A .NET regular expression a field''s value must match when OK is pressed; ^$| in front lets the field stay blank.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1672, '2026-11-03 23:38:19', '2026-11-03 23:38:19', 'maps', NULL, NULL, NULL, 'DbDo''s own table of links between records, such as a contact who belongs to a group.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1673, '2026-11-03 23:38:19', '2026-11-04 21:20:50', 'defs', NULL, NULL, NULL, 'DbDo''s own table of choices, descriptions and patterns for the other tables'' fields.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1675, '2026-11-03 23:38:19', '2026-11-03 23:38:19', 'stations', NULL, NULL, NULL, 'Internet radio stations from Radio Browser and SomaFM, with your own verdicts and notes.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1676, '2026-11-03 23:38:19', '2026-11-04 00:31:56', '*', NULL, NULL, NULL, 'A catalog of Internet radio stations to find, try and keep, with your own verdicts.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1677, '2026-11-05 02:52:09', '2026-11-05 02:52:09', 'stations', 'url', NULL, NULL, 'The web address most about this record, opened with Control+Shift+U.', '^$|^https?://\S+$', 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1678, '2026-11-05 05:38:24', '2026-11-05 05:38:24', 'files', 'file_id', NULL, NULL, 'The number DbDo gives each carried file.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1679, '2026-11-05 05:38:24', '2026-11-05 05:38:24', 'files', 'name', NULL, NULL, 'The file''s name, such as Weekly-Count.sql or report.inix; settings.inix is the database''s own settings.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
