INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1641, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'genre', NULL, NULL, 'The kinds of music or talk the station plays, as the directory lists them.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
