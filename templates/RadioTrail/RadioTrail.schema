INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1620, '2026-11-03 21:20:34', '2026-11-03 21:20:34', '*', 'tags', NULL, NULL, 'fieldDescriptions', 'Words that help find this record, one per line, such as a topic, a team or a feeling.', NULL, NULL, NULL, 0, NULL);
