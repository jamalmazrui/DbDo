INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1638, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'station_id', NULL, NULL, 'fieldDescriptions', 'The record''s own number, given by DbDo; it never changes.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1639, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'name', NULL, NULL, 'fieldDescriptions', 'The station''s name as Radio Browser or SomaFM gives it; it cannot be left blank.', NULL, NULL, NULL, 0, '^\s*\S[\s\S]*$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1640, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'slogan', NULL, NULL, 'fieldDescriptions', 'The station''s own slogan, from its stream or home page.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1641, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'genre', NULL, NULL, 'fieldDescriptions', 'The kinds of music or talk the station plays, as the directory lists them.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1642, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'country', NULL, NULL, 'fieldDescriptions', 'The country the station is in.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1643, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'state', NULL, NULL, 'fieldDescriptions', 'The state or region the station is in.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1644, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'language', NULL, NULL, 'fieldDescriptions', 'The language the station broadcasts in.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1645, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'stream_url', NULL, NULL, 'fieldDescriptions', 'The address of the audio stream itself, which the player plays, starting with http:// or https://; it cannot be left blank.', NULL, NULL, NULL, 0, '^(https?|rtmps?|mms)://\S+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1646, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'playlist_url', NULL, NULL, 'fieldDescriptions', 'The address of a playlist file that leads to the stream, starting with http:// or https://, when the directory gives one.', NULL, NULL, NULL, 0, '^$|^https?://\S+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1647, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'homepage', NULL, NULL, 'fieldDescriptions', 'The station''s own web site, starting with http:// or https://.', NULL, NULL, NULL, 0, '^$|^https?://\S+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1648, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'codec', NULL, NULL, 'fieldDescriptions', 'The audio format of the stream, such as MP3 or AAC.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1649, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'bitrate', NULL, NULL, 'fieldDescriptions', 'The stream''s quality as a whole number, usually in kilobits per second; higher sounds better and uses more data.', NULL, NULL, NULL, 0, '^$|^[0-9]{1,6}$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1650, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'hls', NULL, NULL, 'fieldDescriptions', 'Whether the stream uses HLS, a streaming method some players need to handle differently.', NULL, NULL, NULL, 0, '^$|^yes$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1651, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'votes', NULL, NULL, 'fieldDescriptions', 'How many people have voted for the station on Radio Browser.', NULL, NULL, NULL, 0, '^$|^[0-9]+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1652, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'clicks', NULL, NULL, 'fieldDescriptions', 'How often people have played the station through Radio Browser.', NULL, NULL, NULL, 0, '^$|^[0-9]+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1653, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'trend', NULL, NULL, 'fieldDescriptions', 'Whether plays are rising or falling lately on Radio Browser.', NULL, NULL, NULL, 0, '^$|^-?[0-9]+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1654, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'countrycode', NULL, NULL, 'fieldDescriptions', 'The country''s two-letter code in capitals, such as US or GB.', NULL, NULL, NULL, 0, '^$|^[A-Z]{2}$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1655, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'source', NULL, NULL, 'fieldDescriptions', 'Which directory the station came from, such as Radio Browser or SomaFM, or mine for your own; it cannot be left blank.', NULL, NULL, NULL, 0, '^\s*\S.*$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1656, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'source_id', NULL, NULL, 'fieldDescriptions', 'The station''s id in that directory, which keeps it the same station across refreshes.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1657, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'last_check', NULL, NULL, 'fieldDescriptions', 'When the directory last found the stream working, as year-month-day.', NULL, NULL, NULL, 0, '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1658, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'last_seen', NULL, NULL, 'fieldDescriptions', 'When DbDo last found the station in the directory.', NULL, NULL, NULL, 0, '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1659, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'probed', NULL, NULL, 'fieldDescriptions', 'When DbDo last asked the stream and home page about themselves.', NULL, NULL, NULL, 0, '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1660, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'status', NULL, NULL, 'fieldDescriptions', 'Your own verdict on the station, such as favorite, tried, untried, want to try or dead; F4 offers the choices.', NULL, NULL, NULL, 0, '^$|^(favorite|tried|untried|want to try|dead)$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1661, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'rating', NULL, NULL, 'fieldDescriptions', 'Your own rating of the station, from 1 to 5.', NULL, NULL, NULL, 0, '^$|^[1-5]$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1662, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'descrip', NULL, NULL, 'fieldDescriptions', 'What the station says about itself, from its stream or home page.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1663, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'call_sign', NULL, NULL, 'fieldDescriptions', 'The broadcast call sign, such as KUOW, for an over-the-air station.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1664, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'frequency', NULL, NULL, 'fieldDescriptions', 'Where the station is on the dial, such as 94.9 FM.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1665, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'city', NULL, NULL, 'fieldDescriptions', 'The city the station is licensed to.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1666, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'owner', NULL, NULL, 'fieldDescriptions', 'Who owns the station.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1667, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'format', NULL, NULL, 'fieldDescriptions', 'The station''s broadcast format, such as news, sports or classic rock.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1668, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'wikipedia', NULL, NULL, 'fieldDescriptions', 'The web address of the station''s Wikipedia article, or a dash when there is none.', NULL, NULL, NULL, 0, '^$|^-$|^https://[a-z-]+\.wikipedia\.org/\S+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1669, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'plays', NULL, NULL, 'fieldDescriptions', 'How many times you have played the station in DbDo.', NULL, NULL, NULL, 0, '^$|^[0-9]+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1670, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'last_played', NULL, NULL, 'fieldDescriptions', 'When you last played the station in DbDo.', NULL, NULL, NULL, 0, '^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}([ T][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1671, '2026-11-03 23:38:19', '2026-11-04 21:20:50', 'defs', 'pattern', NULL, NULL, 'fieldDescriptions', 'A .NET regular expression a field''s value must match when OK is pressed; ^$| in front lets the field stay blank.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1672, '2026-11-03 23:38:19', '2026-11-03 23:38:19', 'maps', NULL, NULL, NULL, 'fieldDescriptions', 'DbDo''s own table of links between records, such as a contact who belongs to a group.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1673, '2026-11-03 23:38:19', '2026-11-04 21:20:50', 'defs', NULL, NULL, NULL, 'fieldDescriptions', 'DbDo''s own table of choices, descriptions and patterns for the other tables'' fields.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1675, '2026-11-03 23:38:19', '2026-11-03 23:38:19', 'stations', NULL, NULL, NULL, 'fieldDescriptions', 'Internet radio stations from Radio Browser and SomaFM, with your own verdicts and notes.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1676, '2026-11-03 23:38:19', '2026-11-04 00:31:56', '*', NULL, NULL, NULL, 'fieldDescriptions', 'A catalog of Internet radio stations to find, try and keep, with your own verdicts.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1677, '2026-11-05 02:52:09', '2026-11-05 02:52:09', 'stations', 'url', NULL, NULL, 'fieldDescriptions', 'The web address most about this record, opened with Control+Shift+U.', NULL, NULL, NULL, 0, '^$|^https?://\S+$');
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1678, '2026-11-05 05:38:24', '2026-11-05 05:38:24', 'files', 'file_id', NULL, NULL, 'fieldDescriptions', 'The number DbDo gives each carried file.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1679, '2026-11-05 05:38:24', '2026-11-05 05:38:24', 'files', 'name', NULL, NULL, 'fieldDescriptions', 'The file''s name, such as Weekly-Count.sql or report.inix; settings.inix is the database''s own settings.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1680, '2026-11-05 05:38:24', '2026-11-05 05:38:24', 'files', 'kind', NULL, NULL, 'fieldDescriptions', 'The format of the file''s text, named as a declared type is, such as TEXTSQL, TEXTINIX or TEXTJSCRIPT.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1681, '2026-11-05 05:38:24', '2026-11-05 05:38:24', 'files', 'content', NULL, NULL, 'fieldDescriptions', 'The file''s text, as it would be on disk.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1682, '2026-11-05 05:38:24', '2026-11-05 05:38:24', 'files', NULL, NULL, NULL, 'fieldDescriptions', 'DbDo''s own table of the files the database carries -- its scripts, report definitions and settings -- so the database alone is the whole package.', NULL, NULL, NULL, 0, NULL);
