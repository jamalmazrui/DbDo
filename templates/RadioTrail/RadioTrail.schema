INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1629, '2026-11-03 21:20:34', '2026-11-04 21:20:50', 'defs', 'tbl', NULL, NULL, 'fieldDescriptions', 'The table a choice or description belongs to; * means every table.', NULL, NULL, NULL, 0, NULL);
