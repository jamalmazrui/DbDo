INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1648, '2026-11-03 21:20:34', '2026-11-03 21:20:34', 'stations', 'codec', NULL, NULL, 'The audio format of the stream, such as MP3 or AAC.', NULL, 'fieldDescriptions', NULL, NULL, NULL, 0);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1649, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'bitrate', NULL, NULL, 'The stream''s quality as a whole number, usually in kilobits per second; higher sounds better and uses more data.', '^$|^[0-9]{1,6}$', 'fieldDescriptions', NULL, NULL, NULL, 0);
