INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "descrip", "pattern", "src", "notes", "tags", "url", "marked") VALUES (1646, '2026-11-03 21:20:34', '2026-11-03 23:38:19', 'stations', 'playlist_url', NULL, NULL, 'The address of a playlist file that leads to the stream, starting with http:// or https://, when the directory gives one.', '^$|^https?://\S+$', 'fieldDescriptions', NULL, NULL, NULL, 0);
