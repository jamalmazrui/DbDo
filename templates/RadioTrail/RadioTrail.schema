-- RadioTrail.schema -- the design of RadioTrail.db, written by scripts\checkTemplates --schema.
-- The database itself is built on the development machine and kept out of git. When there is none,
-- fetchStations builds a new one from this file and then fetches the stations. Do not edit by hand: the
-- build rewrites it from the database whenever the design changes.

CREATE TABLE "maps" (
  map_id INTEGER PRIMARY KEY AUTOINCREMENT,
  added TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  edited TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  kind TEXTLINE, tbl1 TEXTLINE, prime1 TEXTLINE, tbl2 TEXTLINE, prime2 TEXTLINE,
  notes TEXTMARKDOWN, tags TEXTMEMO,
  look TEXT GENERATED ALWAYS AS (rtrim(iif(kind IS NOT NULL AND length(CAST(kind AS TEXT))>0, CAST(kind AS TEXT) || ' | ', '') || iif(prime1 IS NOT NULL AND length(CAST(prime1 AS TEXT))>0, CAST(prime1 AS TEXT) || ' | ', '') || iif(prime2 IS NOT NULL AND length(CAST(prime2 AS TEXT))>0, CAST(prime2 AS TEXT) || ' | ', ''), ' | ')) STORED,
  prime TEXT GENERATED ALWAYS AS (coalesce(CAST(tbl1 AS TEXT),'')||'|'||coalesce(CAST(prime1 AS TEXT),'')||'|'||coalesce(CAST(kind AS TEXT),'')||'|'||coalesce(CAST(tbl2 AS TEXT),'')||'|'||coalesce(CAST(prime2 AS TEXT),'')) STORED,
  marked INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE "lookups" (
  lookup_id INTEGER PRIMARY KEY AUTOINCREMENT,
  added TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  edited TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  tbl TEXTLINE, fld TEXTLINE, val TEXTLINE, ordinal INTEGER, src TEXTLINE,
  descrip TEXTMARKDOWN,
  url TEXTLINE,
  notes TEXTMARKDOWN,
  tags TEXTMEMO,
  look TEXT GENERATED ALWAYS AS (rtrim(iif(tbl IS NOT NULL AND length(CAST(tbl AS TEXT))>0, CAST(tbl AS TEXT) || ' | ', '') || iif(fld IS NOT NULL AND length(CAST(fld AS TEXT))>0, CAST(fld AS TEXT) || ' | ', '') || iif(val IS NOT NULL AND length(CAST(val AS TEXT))>0, CAST(val AS TEXT) || ' | ', ''), ' | ')) STORED,
  prime TEXT GENERATED ALWAYS AS (coalesce(CAST(src AS TEXT),'')||'|'||coalesce(CAST(tbl AS TEXT),'')||'|'||coalesce(CAST(fld AS TEXT),'')||'|'||coalesce(CAST(val AS TEXT),'')) STORED,
  marked INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE views (tbl TEXTLINE NOT NULL, fld TEXTLINE NOT NULL, val TEXTLINE, PRIMARY KEY (tbl, fld));
CREATE TABLE "stations" (station_id INTEGER PRIMARY KEY AUTOINCREMENT, added TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, edited TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, name TEXTLINE, slogan TEXTLINE, genre TEXTLINE, country TEXTLINE, state TEXTLINE, language TEXTLINE, stream_url TEXTLINE, playlist_url TEXTLINE, homepage TEXTLINE, codec TEXTLINE, bitrate TEXTLINE, hls TEXTLINE, votes TEXTLINE, clicks TEXTLINE, trend TEXTLINE, countrycode TEXTLINE, source TEXTLINE, source_id TEXTLINE, last_check TEXTLINE, last_seen TEXTLINE, probed TEXTLINE, status TEXTLINE, rating TEXTLINE, descrip TEXTMARKDOWN, notes TEXTMARKDOWN, tags TEXTMEMO, look TEXT GENERATED ALWAYS AS (rtrim(iif(name IS NOT NULL AND length(CAST(name AS TEXT))>0, CAST(name AS TEXT) || ' | ', '') || iif(genre IS NOT NULL AND length(CAST(genre AS TEXT))>0, CAST(genre AS TEXT) || ' | ', '') || iif(state IS NOT NULL AND length(CAST(state AS TEXT))>0, CAST(state AS TEXT) || ' | ', '') || iif(country IS NOT NULL AND length(CAST(country AS TEXT))>0, CAST(country AS TEXT) || ' | ', ''), ' | ')) STORED, "prime" TEXT GENERATED ALWAYS AS (coalesce(nullif(CAST(source_id AS TEXT),''), coalesce(CAST(name AS TEXT),'')||'|'||coalesce(CAST(stream_url AS TEXT),''))) STORED, call_sign TEXTLINE, frequency TEXTLINE, city TEXTLINE, owner TEXTLINE, format TEXTLINE, wikipedia TEXTLINE, plays TEXTLINE, last_played TEXTLINE, marked INTEGER NOT NULL DEFAULT 0);
CREATE TABLE sqlean_define(name text primary key, type text, body text);
