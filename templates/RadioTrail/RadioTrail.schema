INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1631, '2026-11-03 21:20:34', '2026-11-04 21:20:50', 'defs', 'val', NULL, NULL, 'fieldDescriptions', 'One value F4 offers for that field; empty when the row describes the field itself.', NULL, NULL, NULL, 0, NULL);
INSERT INTO "defs" ("def_id", "added", "edited", "tbl", "fld", "val", "ordinal", "src", "descrip", "url", "notes", "tags", "marked", "pattern") VALUES (1632, '2026-11-03 21:20:34', '2026-11-04 21:20:50', 'defs', 'ordinal', NULL, NULL, 'fieldDescriptions', 'Where the value comes in F4''s list, smallest first.', NULL, NULL, NULL, 0, NULL);
