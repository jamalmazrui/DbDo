-- RadioTrail.schema -- the design of RadioTrail.db, written by scripts\checkTemplates --schema.
-- The database itself is built on the development machine and kept out of git. When there is none,
-- fetchStations builds a new one from this file and then fetches the stations. Do not edit by hand: the
-- build rewrites it from the database whenever the design changes.

CREATE TABLE "files" (file_id INTEGER PRIMARY KEY AUTOINCREMENT, added TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, edited TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, name TEXTLINE NOT NULL, kind TEXTLINE, content TEXTMEMO, notes TEXTMARKDOWN, tags TEXTMEMO, url TEXTLINE, look TEXT GENERATED ALWAYS AS (coalesce(CAST(name AS TEXT),'')) STORED, prime TEXT GENERATED ALWAYS AS (coalesce(CAST(name AS TEXT),'')) STORED, marked INTEGER NOT NULL DEFAULT 0);
CREATE TABLE "defs" (def_id INTEGER PRIMARY KEY AUTOINCREMENT, added TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, edited TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, tbl TEXTLINE, fld TEXTLINE, val TEXTLINE, ordinal INTEGER, descrip TEXTMARKDOWN, pattern TEXTLINE, src TEXTLINE, notes TEXTMARKDOWN, tags TEXTMEMO, url TEXTLINE, look TEXT GENERATED ALWAYS AS (rtrim(iif(tbl IS NOT NULL AND length(CAST(tbl AS TEXT))>0, CAST(tbl AS TEXT) || char(31), '') || iif(fld IS NOT NULL AND length(CAST(fld AS TEXT))>0, CAST(fld AS TEXT) || char(31), '') || iif(val IS NOT NULL AND length(CAST(val AS TEXT))>0, CAST(val AS TEXT) || char(31), ''), char(31))) STORED, prime TEXT GENERATED ALWAYS AS (coalesce(CAST(src AS TEXT),'')||char(31)||coalesce(CAST(tbl AS TEXT),'')||char(31)||coalesce(CAST(fld AS TEXT),'')||char(31)||coalesce(CAST(val AS TEXT),'')) STORED, marked INTEGER NOT NULL DEFAULT 0);
CREATE TABLE "maps" (map_id INTEGER PRIMARY KEY AUTOINCREMENT, added TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, edited TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, tbl1 TEXTLINE, prime1 TEXTLINE, kind TEXTLINE, tbl2 TEXTLINE, prime2 TEXTLINE, notes TEXTMARKDOWN, tags TEXTMEMO, look TEXT GENERATED ALWAYS AS (rtrim(iif(kind IS NOT NULL AND length(CAST(kind AS TEXT))>0, CAST(kind AS TEXT) || char(31), '') || iif(prime1 IS NOT NULL AND length(CAST(prime1 AS TEXT))>0, CAST(prime1 AS TEXT) || char(31), '') || iif(prime2 IS NOT NULL AND length(CAST(prime2 AS TEXT))>0, CAST(prime2 AS TEXT) || char(31), ''), char(31))) STORED, prime TEXT GENERATED ALWAYS AS (coalesce(CAST(tbl1 AS TEXT),'')||char(31)||coalesce(CAST(prime1 AS TEXT),'')||char(31)||coalesce(CAST(kind AS TEXT),'')||char(31)||coalesce(CAST(tbl2 AS TEXT),'')||char(31)||coalesce(CAST(prime2 AS TEXT),'')) STORED, marked INTEGER NOT NULL DEFAULT 0);
CREATE TABLE "stations" (station_id INTEGER PRIMARY KEY AUTOINCREMENT, added TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, edited TEXTTIME NOT NULL DEFAULT CURRENT_TIMESTAMP, name TEXTLINE, call_sign TEXTLINE, frequency TEXTLINE, slogan TEXTLINE, genre TEXTLINE, format TEXTLINE, country TEXTLINE, state TEXTLINE, city TEXTLINE, countrycode TEXTLINE, language TEXTLINE, owner TEXTLINE, stream_url TEXTLINE, playlist_url TEXTLINE, homepage TEXTLINE, wikipedia TEXTLINE, codec TEXTLINE, bitrate TEXTLINE, hls TEXTLINE, status TEXTLINE, rating TEXTLINE, descrip TEXTMARKDOWN, source TEXTLINE, source_id TEXTLINE, votes TEXTLINE, clicks TEXTLINE, trend TEXTLINE, last_check TEXTLINE, last_seen TEXTLINE, probed TEXTLINE, plays TEXTLINE, last_played TEXTLINE, notes TEXTMARKDOWN, tags TEXTMEMO, url TEXT GENERATED ALWAYS AS (coalesce(nullif(CAST(stream_url AS TEXT),''), nullif(CAST(playlist_url AS TEXT),''))) STORED, look TEXT GENERATED ALWAYS AS (rtrim(iif(name IS NOT NULL AND length(CAST(name AS TEXT))>0, CAST(name AS TEXT) || char(31), '') || iif(genre IS NOT NULL AND length(CAST(genre AS TEXT))>0, CAST(genre AS TEXT) || char(31), '') || iif(state IS NOT NULL AND length(CAST(state AS TEXT))>0, CAST(state AS TEXT) || char(31), '') || iif(country IS NOT NULL AND length(CAST(country AS TEXT))>0, CAST(country AS TEXT) || char(31), ''), char(31))) STORED, "prime" TEXT GENERATED ALWAYS AS (coalesce(CAST("name" AS TEXT),'')||char(31)||coalesce(CAST("stream_url" AS TEXT),'')) STORED, marked INTEGER NOT NULL DEFAULT 0);
