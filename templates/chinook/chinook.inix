; chinook.inix -- how this database opens, and how each table is heard.
;
; [Database] decides which table the window starts on. Each [Table:<name>]
; decides which fields the row speaks, in what order, and how the rows are
; sorted. DbDo writes these keys back whenever you change the columns, the sort
; or the filter, so what you adjust is remembered here.
;
; A row is heard, not seen, so the field that decides whether to keep listening
; comes first, and three fields is the target. The first field is also what
; first-letter navigation searches.
;
; Chinook is the music-store database many tutorials use. The window opens on
; tracks, the thing everything else is about.

[Database]

InitialTable = tracks

[Table:tracks]

SelectFields = name, composer, unit_price
OrderFields = name
WhereFilter =

[Table:albums]

SelectFields = title
OrderFields = title
WhereFilter =

[Table:artists]

SelectFields = name
OrderFields = name
WhereFilter =

[Table:customers]

SelectFields = last_name, first_name, country
OrderFields = last_name, first_name
WhereFilter =

[Table:invoices]

SelectFields = invoice_date, billing_country, total
OrderFields = invoice_date DESC
WhereFilter =

[Table:lookups]

SelectFields = fld, val
OrderFields = fld, ordinal
WhereFilter =

[Table:maps]

SelectFields = kind, prime1, prime2
OrderFields = kind, prime1
WhereFilter =
