; Reading-List.dbdo -- what you are reading and what you want to read.
;
; Open with Run Script (Alt+Shift+S). Books in progress come first ("reading"
; sorts before "want to read"), then each series in its order, so the next volume
; is the next row.

table = books
where = status IN ('reading', 'want to read')
order = status, series, volume, title
