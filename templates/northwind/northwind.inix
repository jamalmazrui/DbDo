; northwind.inix -- how this database opens, and how each table is heard.
;
; [Database] decides which table the window starts on. Each [Table:<name>]
; decides which fields the row speaks, in what order, and how the rows are
; sorted. DbDo writes these keys back whenever you change the columns, the sort
; or the filter, so what you adjust is remembered here.
;
; A row is heard, not seen, so the field that decides whether to keep listening
; comes first, and three fields is the target. The first field is also what
; first-letter navigation searches.
;
; Northwind is the classic Microsoft sample. The window opens on products;
; orders, customers and suppliers are the trade around them.

[Database]

InitialTable = products

[Table:products]

SelectFields = name, unit_price, units_in_stock
OrderFields = name
WhereFilter =

[Table:orders]

SelectFields = order_date, ship_city, ship_country
OrderFields = order_date DESC
WhereFilter =

[Table:customers]

SelectFields = company, contact, country
OrderFields = company
WhereFilter =

[Table:suppliers]

SelectFields = name, contact, country
OrderFields = name
WhereFilter =

[Table:employees]

SelectFields = last_name, first_name, title
OrderFields = last_name, first_name
WhereFilter =

[Table:lookups]

SelectFields = fld, val
OrderFields = fld, ordinal
WhereFilter =

[Table:maps]

SelectFields = kind, prime1, prime2
OrderFields = kind, prime1
WhereFilter =
